app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# web_game (Node build tooling for the three.js game). dist/ output is
# committed (copied into assets/web/) so `flutter run` works without a
# Node build step; only node_modules is ignored.
/web_game/node_modules/

# fastlane frameitで実行時にコピーされるシステムフォント(コミット不要)
ios/fastlane/frame_assets/fonts/
ios/fastlane/screenshots/*/*.png
ios/fastlane/report.xml
