# macOS / IDE
.DS_Store
**/.idea/
**/*.iml
**/.ruby-lsp/

# Flutter / Dart generated files in every app and package
**/.dart_tool/
**/.flutter-plugins-dependencies
**/build/
**/.packages

# CocoaPods and generated Flutter platform files
**/ios/Pods/
**/macos/Pods/
**/ios/.symlinks/
**/macos/Flutter/ephemeral/

# Generated store media (各アプリ直下のtool/screenshots.sh出力のみが対象。
# ios/fastlane/screenshots/ はFramefile.json等の手書き設定を含むため対象外)
apps/*/screenshots/
apps/*/screenshots_ipad/
apps/*/store_screenshots/
apps/*/store_screenshots_ipad/

# env
.env
.env.*
!.env.example
